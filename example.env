K8S_SSH_USER=XXXX
K8S_SSH_KEY=~/.ssh/id_rsa # path to private key of desired user, user must be same as above K8S_SSH_USER
K8S_SSH_PUB_KEY=~/.ssh/id_rsa.pub
K8S_VERSION=1.34
CRIO_VERSION=1.33
ARGOCD_VERSION=3.1.7
CILIUM_VERSION=1.18.1
CILIUM_LOADBALANCER_IPPOOL=XXX.XXX.XXX.193/27 # 30 usable IPs for LoadBalancer services .193-.223, use calculator.net to determine range
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_VERBOSITY=2
UBUNTU_RELEASE_VERSION=24.04.3
PROXMOX_API_USER=XXXXX@pam
PROXMOX_API_PASSWORD=XXXXXXXXX
PROXMOX_API_HOST=XXX.XXX.XXX.185
PROXMOX_LOCAL_STORAGE=local
PROXMOX_NODE=pve
VM_CPU_TYPE=host # Use 'host' to expose full CPU features (x86-64-v2+) or 'kvm64' for baseline x86-64
VM_GATEWAY=XXX.XXX.XXX.1
VM_NAMESERVER=XXX.XXX.XXX.1
VM_NET_BRIDGE=vmbr0
VM_NET_MODEL=virtio
K8S_CONTROL_1_IP=XXX.XXX.XXX.186
K8S_CONTROL_1_MEM_MB=12288
K8S_CONTROL_1_DISK_GB=50
K8S_CONTROL_1_CPU=2
K8S_NODE_1_IP=XXX.XXX.XXX.187
K8S_NODE_1_MEM_MB=16384
K8S_NODE_1_DISK_GB=250
K8S_NODE_1_CPU=3
REPOSITORY_SSH_URL=git@gitlab.com:XXX/XXX
REPOSITORY_TOKEN=XXXXXXXXXXXXX # https://gitlab.com/help/user/project/settings/project_access_tokens.md
ENABLE_GATEWAY_API=false # Set to true to enable Gateway API mode, false for Ingress Controller mode

# Storage Configuration - Choose ONE option:
# Option 1: Rook-Ceph (recommended) - In-cluster storage using secondary disks
ENABLE_ROOK=true # Uses auto-discovered secondary disks on Proxmox host
# Note: Disks must be raw (no LVM/partitions). For re-provisioning, run on Proxmox:
#   wipefs -a /dev/<disk>; pvremove -y /dev/<disk>  # For each secondary disk
# PROXMOX_SECONDARY_STORAGE=vm-storage # Override: Name for secondary storage pool
# PROXMOX_SECONDARY_VG=vg-secondary # Override: LVM volume group name

# Option 2: External CephFS - Connects to Ceph cluster running outside K8s
ENABLE_CEPH=false # Set to true to use external Ceph cluster instead of Rook
# CEPH_CSI_VERSION=3.15.0 # Ceph CSI driver version
# CEPH_MONITOR=XXX.XXX.XXX.XXX:6789 # Ceph monitor address (get with: ceph mon dump)
# CEPH_FSID=XXXXXXXXXXXX # Ceph cluster ID (get with: ceph fsid)
# CEPH_FS_NAME=cephfs # CephFS filesystem name
# CEPH_FS_POOL=cephfs_data # CephFS data pool name
# CEPH_K8S_USER=kubernetes # Ceph user for Kubernetes CSI driver
# CEPH_K8S_KEY=XXXXXXXXXXXX # Base64 encoded key (get with: ceph auth get-key client.kubernetes | base64 -w 0)
# CEPH_ADMIN_KEY=XXXXXXXXXXXX # Base64 encoded admin key (get with: ceph auth get-key client.admin | base64 -w 0)

ENABLE_CUDA=false # Set to true to enable NVIDIA GPU support on nodes with compute: cuda label
ENABLE_ISTIO=false # Set to true to enable Istio Ambient service mesh (requires Cilium compatibility settings)

# Harbor Container Registry — pull-through proxy cache for all upstream registries.
# Deployed in sync-wave 2 after cert-manager and rook storage.
# Admin password is auto-generated by Ansible and stored in a K8s Secret.
# OIDC via Keycloak is the primary auth method (cluster-admins = Harbor admin).
# HARBOR_REGISTRY_SIZE=50Gi # Override: PVC size for cached images (default 50Gi)
ISTIO_VERSION=1.26.6 # Latest stable version (1.23+ requires x86-64-v2: set VM_CPU_TYPE=host, supported until Jan 2026)
ISTIO_MESH_ID=mesh1 # Mesh identifier for multi-cluster setups (can be same across clusters)
ISTIO_CLUSTER_NAME=cluster-1 # Unique cluster name within the mesh (change per cluster)
ISTIO_NETWORK=network-1 # Network identifier for multi-cluster routing (change if clusters in different networks)
NVIDIA_DEVICE_PLUGIN_VERSION=v0.14.5 # NVIDIA Device Plugin version for Kubernetes GPU scheduling
GPU_PCI_ADDRESS=0000:01:00 # PCI address of GPU for passthrough (find with: lspci | grep -i vga on Proxmox host)
